# Yardstick environment variables. Placeholders only — never commit real values.
# Local: copy to .env.local (or run `vercel env pull .env.local`).
# Production: Vercel → Project → Settings → Environment Variables. Changes need a redeploy.

# --- Required ---
# Neon Postgres (the Vercel Neon integration sets both automatically).
DATABASE_URL="postgres://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Comma-separated RPC endpoints, best first. The public mainnet RPC is always added last.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"

# Public URL of the site (used in the sign-in message and share images).
SITE_URL="https://your-project.vercel.app"

# Protects /api/cron. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate-a-long-random-hex-string"

# --- Optional ---
# Alternative to putting the Helius URL in SOLANA_RPC_URL.
HELIUS_API_KEY=""
# Address of the site's frozen lookup table (create it once at /setup). Needed for launches with a dev buy.
PUMP_LOOKUP_TABLE=""
# Pinata JWT: fallback for metadata uploads if pump.fun's IPFS endpoint is unreachable.
PINATA_JWT=""
# CoinGecko demo key: SOL price falls back to Coinbase and Kraken without it.
COINGECKO_API_KEY=""
# RPC credits per UTC day (Helius free plan is 1M/month ≈ 33k/day).
RPC_DAILY_BUDGET="30000"
# Target number of pump.fun coins sampled into the baseline per day.
BASELINE_DAILY_SAMPLE="150"
